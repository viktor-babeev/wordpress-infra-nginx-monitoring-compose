# ==============================================================================
# ВЕРСИИ ПО (Фиксированные и актуальные согласно https://endoflife.date)
# ==============================================================================
MYSQL_VERSION=8.4.0
WORDPRESS_VERSION=6.7-php8.2-apache
PMA_VERSION=5.2
NGINX_VERSION=1.26.2-alpine

# Компоненты мониторинга (Актуальные стабильные версии на 2026 год)
PROMETHEUS_VERSION=v2.51.0
GRAFANA_VERSION=10.4.2
NODE_EXPORTER_VERSION=v1.8.1

# ==============================================================================
# НАСТРОЙКИ СЕТЕВЫХ ПОРТОВ (Заперты на loopback-интерфейсе 127.0.0.1 хоста)
# ==============================================================================
WP_LOCAL_PORT=8081
PMA_LOCAL_PORT=8082
PROM_LOCAL_PORT=9090
GRAFANA_LOCAL_PORT=3000
NODE_EXPORTER_LOCAL_PORT=9100

# ==============================================================================
# СЕКРЕТЫ БАЗЫ ДАННЫХ И МОНИТОРИНГА
# ==============================================================================
MYSQL_ROOT_PASSWORD=SuperRootSecurePass2026!
MYSQL_DATABASE=wp_db
MYSQL_USER=wp_admin
MYSQL_PASSWORD=WpSecurePassword2026!

# Административные данные Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=GrafanaSuperSecurePass2026!
